# ─── MongoDB Connection ────────────────────────────────────────────────────────
# Full connection URI — supports replica sets, auth sources, TLS options, etc.
# Examples:
#   mongodb://user:pass@host:27017/?authSource=admin
#   mongodb://user:pass@host:27017/mydb?replicaSet=rs0&authSource=admin
#   mongodb+srv://user:pass@cluster.mongodb.net/?authSource=admin
MONGODB_URI=mongodb://user:password@192.168.1.100:27017/?authSource=admin

# ─── S3-compatible Storage ───────────────────────────────────────────────────
# Works with: MinIO, AWS S3, DigitalOcean Spaces, Backblaze B2, Cloudflare R2, OVH Object Storage
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=https://your-minio-or-s3-endpoint.com
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PATH=backups/mongodb

# ─── Retention ────────────────────────────────────────────────────────────────
# Number of days to keep backups (local + remote)
TTL_DAYS=7
# Always keep N newest backups even if older than TTL (0 = TTL only)
MIN_BACKUPS=0

# ─── Local storage (optional) ─────────────────────────────────────────────────
BACKUP_DIR=/backup
